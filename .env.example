# --- System Environment ---
APP_ENV=production
LOG_LEVEL=INFO
TIMEZONE=Asia/Kolkata
DATABASE_URL=sqlite+aiosqlite:///data/tradebot.db

# --- LIVE Trading Master Guard (Double Confirmation) ---
TRADE_MODE=PAPER
CONFIRM_LIVE_TRADING_PHRASE=""

# --- Broker Selection: ANGELONE | KITE | PAPER ---
BROKER_TYPE=ANGELONE

# --- Angel One SmartAPI Credentials ---
ANGELONE_API_KEY=your_angel_one_api_key
ANGELONE_CLIENT_ID=your_angel_one_client_id
ANGELONE_PASSWORD=your_angel_one_password
ANGELONE_TOTP_SECRET=your_angel_one_totp_secret

# --- Zerodha Kite Credentials (alternative) ---
KITE_API_KEY=
KITE_API_SECRET=
KITE_USER_ID=
KITE_PASSWORD=
KITE_TOTP_KEY=

# --- Notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Web UI Security ---
API_SECRET_KEY=change_this_to_a_secure_random_key_in_production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
